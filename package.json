{
  "name": "hundebuechli",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "bun": ">=1.3.14",
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "expo customize tsconfig.json > /dev/null && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-length": "node scripts/check-file-length.mjs",
    "check:expo": "EXPO_OFFLINE=1 expo install --check",
    "test": "jest",
    "export:web": "rm -rf dist && expo export --platform web && node scripts/web-harden.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "verify": "bun run format:check && bun run check:file-length && bun run lint && bun run typecheck && bun run test && bun run check:expo"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "drizzle-orm": "0.45.2",
    "expo": "57.0.22",
    "expo-asset": "57.0.17",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.18",
    "expo-crypto": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-image-manipulator": "57.0.17",
    "expo-image-picker": "57.0.17",
    "expo-linking": "57.0.10",
    "expo-notifications": "57.0.19",
    "expo-router": "57.0.21",
    "expo-splash-screen": "57.0.9",
    "expo-sqlite": "57.0.3",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.3",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "sql.js": "1.14.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.4",
    "@types/react": "19.2.18",
    "@types/sql.js": "1.4.11",
    "babel-plugin-inline-import": "3.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "globals": "17.12.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "prettier": "3.9.6",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
